   },
   "outputs": [],
   "source": [
    "import re\n",
    "import os\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import scipy as sp\n",
    "import random\n",
    "import itertools\n",
    "import warnings\n",
    "import math\n",
    "warnings.filterwarnings('ignore')"
   ]
  },
  {
   "cell_type": "code",
   "source": [
    "sns.set_theme('notebook')\n",
    "sns.set_style('ticks')\n",
    "kabat_column = 'kabat_position'\n",
    "sites_column = 'site'\n",
    "germline_col = 'germline_aa'\n",
    "mature_col = 'mature_aa'\n",
    "\n",
    "def mutation_convert_label(meta_in,sites_col = sites_column,IMGT_col = kabat_column,g_col = germline_col,m_col = mature_col):\n",
    "  mapping = {}\n",
    "  for row, site in enumerate(meta_in[sites_col].values):\n",
    "    mapping[f'{site}'] = f'{meta_in.loc[row,f'{g_col}']}{meta_in.loc[row,f'{IMGT_col}']}{meta_in.loc[row,f'{m_col}']}'\n",
    "  return mapping"
   ],
   "metadata": {
    "id": "8QXKhlCWEHCt"
   },
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": [
    "data_dir = \"../data\"\n",
    "fig_dir = \"../figures\"\n",
    "table_dir = \"../tables\"\n",
    "os.makedirs(fig_dir, exist_ok=True)\n",
    "os.makedirs(table_dir, exist_ok=True)\n",
    "png_dpi = 300\n",
    "\n",
    "plt.rcParams[\"svg.fonttype\"] = \"path\"   # illustrator drops live text\n",
    "plt.rcParams[\"pdf.fonttype\"] = 42\n",
    "\n",
    "bnAb_list = ['1NC9','CH235.12','N49P7','NIH45-46','VRC-PG20','VRC01','VRC07','VRC13','VRC16']\n",
    "\n",
    "# display name to file stem; the hyphens and the dot do not appear in any filename\n",
    "name_to_stem = {'1NC9':'1NC9','CH235.12':'CH235_12','N49P7':'N49P7','NIH45-46':'NIH4546',\n",
    "                'VRC-PG20':'VRCPG20','VRC01':'VRC01','VRC07':'VRC07','VRC13':'VRC13',\n",
    "                'VRC16':'VRC16'}\n",
    "\n",
    "rep_avg_cols = ['id','vh_aa'] + [f'site_{i}' for i in range(10)] + ['antigen']\n",
    "\n",
    "\n",
    "def save_figure(stem):\n",
    "    \"\"\"Write the current figure to png, pdf and svg, then check the svg has no live text.\"\"\"\n",
    "    name = re.sub(r\"[^A-Za-z0-9._-]+\", \"_\", stem).strip(\"_\")\n",
    "    path = f\"{fig_dir}/{name}\"\n",
    "    plt.savefig(f\"{path}.png\", dpi=png_dpi, bbox_inches=\"tight\")\n",
    "    plt.savefig(f\"{path}.pdf\", bbox_inches=\"tight\")\n",
    "    plt.savefig(f\"{path}.svg\", bbox_inches=\"tight\")\n",
    "    assert open(f\"{path}.svg\").read().count(\"<text\") == 0, \"live text in svg, check svg.fonttype\"\n",
    "\n",
    "\n",
    "kds_dict = {}; kds_dict_rep_avg = {}; meta_dict = {}\n",
    "CH_all_dict = {}; SF_all_dict = {}; CH_params_dict = {}; SF_params_dict = {}\n",
    "for name in bnAb_list:\n",
    "    stem = name_to_stem[name]\n",
    "    kds = pd.read_csv(f\"{data_dir}/{stem}_kds.csv\")\n",
    "    kds_dict[name] = kds\n",
    "    kds_dict_rep_avg[name] = kds.groupby(by=rep_avg_cols).agg({'nlog10_Kd':'mean'}).reset_index()\n",
    "    meta_dict[name] = pd.read_csv(f\"{data_dir}/{stem}_meta.csv\")\n",
    "    CH_all_dict[name] = pd.read_csv(f\"{data_dir}/{stem}_CH505TF_BEST_df_all.csv\")\n",
    "    SF_all_dict[name] = pd.read_csv(f\"{data_dir}/{stem}_SF162_BEST_df_all.csv\")\n",
    "    CH_params_dict[name] = pd.read_csv(f\"{data_dir}/{stem}_CH505TF_BEST_df_params.csv\")\n",
    "    SF_params_dict[name] = pd.read_csv(f\"{data_dir}/{stem}_SF162_BEST_df_params.csv\")"
   ],
