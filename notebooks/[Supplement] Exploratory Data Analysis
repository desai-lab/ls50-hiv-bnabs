    "for key, df in kds_dict_rep_avg.items():\n",
    "  summary_statistic_df.loc[key,'unique_genotypes_tot'] = df['id'].nunique()\n",
    "  summary_statistic_df.loc[key,'unique_genotypes_CH505TF'] = df[df['antigen'] == 'CH505TF']['id'].nunique()\n",
    "  summary_statistic_df.loc[key,'unique_genotypes_SF162'] = df[df['antigen'] == 'SF162']['id'].nunique()\n",
    "  summary_statistic_df.loc[key,'floored_var_CH505TF'] = len(df[(df['antigen'] == 'CH505TF') & (df['nlog10_Kd'] == 6)])\n",
    "  summary_statistic_df.loc[key,'florred_var_SF162'] = len(df[(df['antigen'] == 'SF162') & (df['nlog10_Kd'] == 6)])\n",
    "\n",
    "for key, df in kds_dict.items():\n",
    "  summary_statistic_df.loc[key,'CH_floor'] = len(df[(df['antigen'] == 'CH505TF') & (df['nlog10_Kd'] == 6)])\n",
