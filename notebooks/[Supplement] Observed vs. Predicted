    "def build_grid():\n",
    "    \"\"\"18 panel observed vs predicted grid, one antibody pair per column block.\"\"\"\n",
    "    cells = [c for ab in grid_abs for c in ((ab, \"CH505TF\"), (ab, \"SF162\"))]\n",
    "    data = [load_complex(ab, ag) for ab, ag in cells]\n",
    "    lo, hi = shared_range(data)\n",
    "\n",
    "    fig = plt.figure(figsize=(13.5, 8.1))\n",
    "    gs = gridspec.GridSpec(3, 6, figure=fig, hspace=0.82, wspace=0.30,\n",
    "                           left=0.085, right=0.985, top=0.79, bottom=0.11)\n",
    "    axes = []\n",
    "    for cell, (ab, ag) in enumerate(cells):\n",
    "        row, col = divmod(cell, 6)\n",
    "        ax = fig.add_subplot(gs[row, col])\n",
    "        axes.append(ax)\n",
    "        d = data[cell]\n",
    "        style_axes(ax, lo, hi)\n",
    "        ax.scatter(d[\"obs\"], d[\"pred\"], s=7, c=antigen_hex[ag], alpha=0.5,\n",
    "                   linewidths=0, zorder=2)\n",
    "        r, rmse = fit_stats(d[\"obs\"], d[\"pred\"])\n",
    "        stat_box(ax, [f\"r={r:.3f}\", f\"RMSE={rmse:.3f}\", f\"n={len(d['obs'])}\"])\n",
    "\n",
    "        title = f\"best-fit order: {d['order']}\"\n",
    "        params = alpha_line(ab, ag)\n",
    "        if params:\n",
    "            title += f\"\\n{params}\"\n",
    "        ax.set_title(title, fontsize=8.5, color=c_ink, pad=4)\n",
    "\n",
    "    # a params line makes each title two lines, so the antibody label has to clear more\n",
    "    header_dy = 0.055 if any(alpha_line(ab, ag) for ab, ag in cells) else 0.032\n",
    "    for j, ab in enumerate(grid_abs):\n",
    "        group_header(fig, [axes[2 * j], axes[2 * j + 1]], ab, dy=header_dy)\n",
    "\n",
    "    fig.text(0.5, 0.965, \"Observed vs. predicted affinity for best model fits\",\n",
    "             ha=\"center\", fontsize=14, color=c_ink, weight=\"bold\")\n",
    "    fig.legend(handles=[Line2D([0], [0], marker=\"o\", ls=\"\", mfc=antigen_hex[a], mec=\"none\",\n",
    "                               ms=8, label=a) for a in (\"CH505TF\", \"SF162\")],\n",
    "               loc=\"upper center\", ncol=2, frameon=False, fontsize=10,\n",
    "               bbox_to_anchor=(0.5, 0.945), columnspacing=1.6, handletextpad=0.4)\n",
    "\n",
    "    for j in range(3):\n",
    "        pair = [axes[12 + 2 * j].get_position(), axes[13 + 2 * j].get_position()]\n",
    "        xc = (min(p.x0 for p in pair) + max(p.x1 for p in pair)) / 2\n",
    "        fig.text(xc, 0.052, xlabel, ha=\"center\", va=\"center\", fontsize=9.5, color=c_ink)\n",
    "    fig.text(0.022, 0.455, ylabel, ha=\"center\", va=\"center\", rotation=90,\n",
    "             fontsize=12.5, color=c_ink)\n",
    "    return fig"
   ],
