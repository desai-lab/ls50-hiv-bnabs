    "## Loading and stats"
   ],
   "id": "ru2WatiRAXH7"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "-Y88mzV2AXH7"
   },
   "outputs": [],
   "source": [
    "# Observed, predicted, and selected order for one antibody-antigen complex\n",
    "\n",
    "def load_complex(ab, ag):\n",
    "    s = stem_map[ab]\n",
    "    kds = pd.read_csv(f\"{data_dir}/{s}_kds.csv\")\n",
    "    sub = kds[kds[\"antigen\"] == ag].copy()\n",
    "    sub[\"tok\"] = sub[site_cols].agg(\"\".join, axis=1)  # G/M string, site_0 leftmost\n",
    "    obs = sub.groupby(\"tok\")[\"nlog10_Kd\"].mean().dropna()\n",
    "\n",
    "    dfa = pd.read_csv(f\"{data_dir}/{s}_{ag}_BEST_df_all.csv\")\n",
    "    dfa[\"tok\"] = dfa[site_cols].agg(\"\".join, axis=1)\n",
    "    pred = dfa.set_index(\"tok\")[\"predicted_kd_full\"].reindex(obs.index)\n",
    "\n",
    "    order = int(pd.read_csv(f\"{data_dir}/{s}_{ag}_BEST_df_params.csv\")[\"order\"].max())\n",
    "    return dict(geno=obs.index.to_numpy(), obs=obs.to_numpy(),\n",
    "                pred=pred.to_numpy(), order=order)\n",
    "\n",
    "\n",
    "# Mutation labels per site index, for example N52K at index 4\n",
    "def site_labels(ab):\n",
    "    meta = pd.read_csv(f\"{data_dir}/{stem_map[ab]}_meta.csv\").reset_index(drop=True)\n",
    "    return (meta[\"germline_aa\"].astype(str) + meta[\"kabat_position\"].astype(str)\n",
    "            + meta[\"mature_aa\"].astype(str)).tolist()\n",
    "\n",
    "# Accept a site as an index 0 to 9 or as a label like N52K\n",
    "def site_index(ab, site):\n",
    "    if isinstance(site, (int, np.integer)):\n",
    "        return int(site)\n",
    "    labels = site_labels(ab)\n",
    "    if site not in labels:\n",
    "        raise ValueError(f\"{site} not a site of {ab}. options: {labels}\")\n",
    "    return labels.index(site)\n",
    "\n",
    "\n",
    "def fit_stats(obs, pred):\n",
    "    return np.corrcoef(obs, pred)[0, 1], float(np.sqrt(np.mean((obs - pred) ** 2)))\n",
    "\n",
    "\n",
    "def alpha_line(ab, ag):\n",
    "    a = alphas.get((ab, ag))\n",
    "    return None if a is None else f\"L1 = {a[0]:g}, L2 = {a[1]:g}\"\n",
    "\n",
    "# Spread floor-censored points below the threshold so the pile-up is readable\n",
    "def jitter_censored(obs, pred, rng):\n",
    "    x, y = obs.copy(), pred.copy()\n",
    "    xf, yf = obs == floor, pred == floor\n",
    "    x[xf] = floor - rng.uniform(0, jitter_band, int(xf.sum()))\n",
    "    y[yf] = floor - rng.uniform(0, jitter_band, int(yf.sum()))\n",
    "    return x, y"
   ],
   "id": "-Y88mzV2AXH7"
