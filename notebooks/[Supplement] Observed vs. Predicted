   },
   "outputs": [],
   "source": [
    "alphas = {\n",
    "    (\"CH235.12\", \"CH505TF\"): (0.1, 0.1),  (\"CH235.12\", \"SF162\"): (0.1, 0.1),\n",
    "    (\"1NC9\", \"CH505TF\"): (0.1, 0),        (\"1NC9\", \"SF162\"): (0.1, 0),\n",
