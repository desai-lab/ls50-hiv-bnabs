    "## Figure 2: selected sites\n",
    "\n",
    "`draw_site_panel` puts one complex on an existing axis. `build_site_panel` wraps it in\n",
    "its own figure for a single plot, and `build_site_figure` lays several out in a row on\n",
    "a shared axis range. The site can be an index 0 to 9 or a label like `N52K`."
   ],
   "id": "p5kC2lD_AXIA"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "kapMBxWGAXIA"
   },
   "outputs": [],
   "source": [
    "#Observed vs predicted for one complex, split by germline or mutant at one site\n",
    "def draw_site_panel(ax, ab, ag, site, lo=None, hi=None, show_ylabel=True):\n",
    "    k = site_index(ab, site)\n",
    "    lab = site_labels(ab)[k]\n",
    "    d = load_complex(ab, ag)\n",
    "    if lo is None or hi is None:\n",
    "        lo, hi = shared_range([d])\n",
    "        lo = min(lo, floor - jitter_band - 0.04)\n",
    "\n",
    "    style_axes(ax, lo, hi)\n",
    "    ax.axvline(floor, color=c_line, lw=0.8, ls=(0, (4, 3)), zorder=1)\n",
    "    ax.axhline(floor, color=c_line, lw=0.8, ls=(0, (4, 3)), zorder=1)\n",
    "\n",
    "    x, y = jitter_censored(d[\"obs\"], d[\"pred\"], np.random.default_rng(jitter_seed))\n",
    "    mut = np.array([g[k] == \"M\" for g in d[\"geno\"]])\n",
    "    ax.scatter(x[~mut], y[~mut], s=10, c=germ_hex, alpha=0.6, linewidths=0, zorder=2)\n",
    "    ax.scatter(x[mut], y[mut], s=10, c=mut_hex, alpha=0.6, linewidths=0, zorder=3)\n",
    "\n",
    "    ax.set_title(f\"Antibody: {ab}\\nAntigen: {ag}\", fontsize=9, color=c_ink, pad=6)\n",
    "    ax.set_xlabel(xlabel, fontsize=8, color=c_ink)\n",
    "    if show_ylabel:\n",
    "        ax.set_ylabel(ylabel, fontsize=10, color=c_ink, labelpad=10)\n",
    "    ax.legend(handles=[Line2D([0], [0], marker=\"o\", ls=\"\", mfc=germ_hex, mec=\"none\",\n",
    "                              ms=6, label=f\"\\u2212{lab}\"),\n",
    "                       Line2D([0], [0], marker=\"o\", ls=\"\", mfc=mut_hex, mec=\"none\",\n",
    "                              ms=6, label=f\"+{lab}\")],\n",
    "              loc=\"upper left\", fontsize=7.5, frameon=True, framealpha=0.9,\n",
    "              edgecolor=c_line, handletextpad=0.4, borderpad=0.5)\n",
    "    return ax\n",
    "\n",
    "# One standalone selected-site figure, for any antibody, antigen, and site\n",
    "def build_site_panel(ab, ag, site):\n",
    "    fig = plt.figure(figsize=(4.2, 4.4))\n",
    "    draw_site_panel(fig.add_subplot(111), ab, ag, site)\n",
    "    fig.subplots_adjust(left=0.20, right=0.96, top=0.82, bottom=0.16)\n",
    "    return fig\n",
    "\n",
    "# Row of selected-site panels sharing one axis range, as used in the supplement\n",
    "def build_site_figure(specs):\n",
    "    data = [load_complex(ab, ag) for ab, ag, _ in specs]\n",
    "    lo, hi = shared_range(data)\n",
    "    lo = min(lo, floor - jitter_band - 0.04)\n",
    "\n",
    "    fig = plt.figure(figsize=(3.3 * len(specs), 4.1))\n",
    "    gs = gridspec.GridSpec(1, len(specs), figure=fig, wspace=0.30,\n",
    "                           left=0.10, right=0.99, top=0.78, bottom=0.17)\n",
    "    for j, (ab, ag, site) in enumerate(specs):\n",
    "        draw_site_panel(fig.add_subplot(gs[0, j]), ab, ag, site, lo, hi,\n",
    "                        show_ylabel=(j == 0))\n",
    "    fig.text(0.5, 0.955, \"Observed vs. predicted fits at selected sites\",\n",
    "             ha=\"center\", fontsize=12.5, color=c_ink, weight=\"bold\")\n",
    "    return fig"
   ],
