   "source": [
    "import os\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib import gridspec\n",
    "from matplotlib.ticker import FormatStrFormatter\n",
    "from matplotlib.lines import Line2D\n",
    "\n",
    "data_dir = \"../data\"\n",
    "fig_dir = \"../figures\"\n",
    "os.makedirs(fig_dir, exist_ok=True)\n",
    "png_dpi = 300\n",
    "\n",
    "plt.rcParams[\"svg.fonttype\"] = \"path\"\n",
    "plt.rcParams[\"pdf.fonttype\"] = 42\n",
    "\n",
    "antigen_hex = {\"CH505TF\": \"#E66100\", \"SF162\": \"#5D3A9B\"}\n",
    "germ_hex = \"#386A4F\"\n",
    "mut_hex = \"#D48DA6\"\n",
    "\n",
    "c_ink = \"#1a1a2e\"\n",
    "c_muted = \"#6b6b7b\"\n",
    "c_line = \"#e3e3ea\"\n",
    "c_spine = \"#333333\"\n",
    "c_identity = \"#444444\"\n",
    "\n",
    "floor = 6.0         # Tobit detection floor in -log10 Kd units\n",
    "jitter_band = 0.15  # censored points spread into a band below the floor\n",
    "jitter_seed = 0\n",
    "tick_step = 0.5     # shared x and y tick spacing\n",
    "\n",
    "xlabel = r\"Measured Binding Affinity ($-\\log_{10}\\mathrm{K_D}$)\"\n",
    "ylabel = r\"Inferred Binding Affinity ($-\\log_{10}\\mathrm{K_D}$)\"\n",
    "\n",
    "included_abs = [\"CH235.12\", \"1NC9\", \"N49P7\", \"VRC01\", \"VRC07\", \"VRC13\"]\n",
    "excluded_abs = [\"NIH45-46\", \"VRC-PG20\", \"VRC16\"]\n",
    "grid_abs = included_abs + excluded_abs\n",
    "\n",
    "stem_map = {\"CH235.12\": \"CH235_12\", \"1NC9\": \"1NC9\", \"N49P7\": \"N49P7\", \"VRC01\": \"VRC01\",\n",
    "            \"VRC07\": \"VRC07\", \"VRC13\": \"VRC13\", \"NIH45-46\": \"NIH4546\",\n",
    "            \"VRC-PG20\": \"VRCPG20\", \"VRC16\": \"VRC16\"}\n",
    "\n",
    "site_cols = [f\"site_{i}\" for i in range(10)]"
   ],
