    "def shared_range(complexes):\n",
    "    vals = np.concatenate([np.concatenate([c[\"obs\"], c[\"pred\"]]) for c in complexes])\n",
    "    lo, hi = np.nanmin(vals), np.nanmax(vals)\n",
    "    pad = 0.04 * (hi - lo)\n",
    "    return lo - pad, hi + pad\n",
    "\n",
    "\n",
    "def style_axes(ax, lo, hi):\n",
    "    ax.set_xlim(lo, hi)\n",
    "    ax.set_ylim(lo, hi)\n",
    "    ax.set_aspect(\"equal\")\n",
    "    ax.plot([lo, hi], [lo, hi], ls=\"--\", lw=0.8, color=c_identity, zorder=1)\n",
    "    for s in ax.spines.values():\n",
    "        s.set_color(c_spine)\n",
    "        s.set_linewidth(1.0)\n",
    "    ticks = np.arange(np.ceil(lo / tick_step) * tick_step, hi + 1e-9, tick_step)\n",
    "    ax.set_xticks(ticks)\n",
    "    ax.set_yticks(ticks)\n",
    "    ax.xaxis.set_major_formatter(FormatStrFormatter(\"%.1f\"))\n",
    "    ax.yaxis.set_major_formatter(FormatStrFormatter(\"%.1f\"))\n",
    "    ax.tick_params(length=3, labelsize=7, colors=c_muted, labelcolor=c_ink)\n",
    "    ax.grid(True, color=\"#f0f0f4\", lw=0.6, zorder=0)\n",
    "\n",
    "\n",
    "def stat_box(ax, lines):\n",
    "    ax.text(0.04, 0.96, \"\\n\".join(lines), transform=ax.transAxes, va=\"top\", ha=\"left\",\n",
    "            fontsize=6.2, color=c_ink, linespacing=1.35,\n",
    "            bbox=dict(boxstyle=\"round,pad=0.3\", fc=\"white\", ec=c_line, lw=0.6, alpha=0.9))\n",
    "\n",
    "\n",
    "def group_header(fig, axes, text, dy=0.032):\n",
    "    \"\"\"Center an antibody label above the pair of antigen panels below it.\"\"\"\n",
    "    pos = [a.get_position() for a in axes]\n",
    "    xc = (min(p.x0 for p in pos) + max(p.x1 for p in pos)) / 2\n",
    "    fig.text(xc, max(p.y1 for p in pos) + dy, text, ha=\"center\", va=\"bottom\",\n",
    "             fontsize=10.5, color=c_ink, weight=\"bold\")\n",
    "\n",
    "\n",
    "def save_figure(fig, name):\n",
    "    \"\"\"Write png, pdf, and svg, then confirm the svg carries no live text.\"\"\"\n",
    "    for ext in (\"png\", \"pdf\", \"svg\"):\n",
    "        fig.savefig(f\"{fig_dir}/{name}.{ext}\", dpi=png_dpi, bbox_inches=\"tight\")\n",
    "    svg = open(f\"{fig_dir}/{name}.svg\").read()\n",
    "    assert svg.count(\"<text\") == 0, \"live text in svg, set svg.fonttype='path'\"\n",
    "    print(name, \"saved (png, pdf, svg)\")"
   ],
   "id": "DOLVtGlOAXH9"
  },
